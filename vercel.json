{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run site",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/landing.html", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/ai-receptionist/restaurants/dubai", "destination": "/ai-receptionist/restaurants/ae/dubai", "permanent": true },
    { "source": "/ai-receptionist/hair-salons/sharjah", "destination": "/ai-receptionist/hair-salons/ae/sharjah", "permanent": true },
    { "source": "/ai-receptionist/dental-clinics/london", "destination": "/ai-receptionist/dental-clinics/gb/london", "permanent": true },
    { "source": "/ai-receptionist/in/dubai", "destination": "/ai-receptionist/in/ae/dubai", "permanent": true },
    { "source": "/ai-receptionist/in/sharjah", "destination": "/ai-receptionist/in/ae/sharjah", "permanent": true },
    { "source": "/ai-receptionist/in/london", "destination": "/ai-receptionist/in/gb/london", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://app.belline.ai; script-src 'self'; frame-src https://app.belline.ai; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/site.:hash.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/site.:hash.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
