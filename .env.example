# ---------------------------------------------------------------------------
# Belline — AI voice receptionist
#
# Copy to .env and fill in what you have. Every provider degrades to a mock
# implementation when its key is missing, so the app runs with an empty file.
# ---------------------------------------------------------------------------

# Brain. Without this the agent falls back to a scripted mock that still
# exercises the tool layer, so the dashboard and booking engine stay testable.
ANTHROPIC_API_KEY=

# Speech-to-text (streaming). Without it, browser voice mode records but
# transcribes nothing — use the text console instead.
DEEPGRAM_API_KEY=

# Text-to-speech (streaming). Without it, the agent replies in text only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Telephony (optional — only needed to answer real phone calls).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public wss:// origin Twilio should stream media to, e.g. wss://abc.ngrok.app
PUBLIC_WS_ORIGIN=
# An SMS-capable Twilio number. Set this and every booking gets a written
# confirmation, so nobody writes the reference down wrong.
TWILIO_SMS_FROM=

# Signs the short-lived token Twilio hands back when it opens a media stream.
# Set this to 40+ random characters in production; without it the stream
# endpoint falls back to the Twilio auth token, and then to a known default.
SESSION_SECRET=

# Where the book is written. Point this at a mounted volume in a container —
# the container's own filesystem is wiped on every deploy.
DATA_DIR=

PORT=3000

# ---------------------------------------------------------------------------
# Sales engine (docs/sales-engine/)
#
# All optional. Without DATABASE_URL the /sales dashboard reports "not
# configured" and the voice product behaves exactly as it does today.
# ---------------------------------------------------------------------------

# Postgres for the sales engine only. The voice product keeps its JSON store.
#   Railway: add a Postgres service, copy DATABASE_URL from its Variables tab.
#   Local:   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=belline postgres:16
DATABASE_URL=

# Background worker (npm run worker). Runs beside the voice server, not on Vercel.
SALES_WORKER_CONCURRENCY=4

# Models. Every sales task defaults to claude-opus-5; set one to trade cost for
# quality on that task alone. See docs/sales-engine/INTEGRATIONS.md §7.
SALES_DEFAULT_MODEL=
SALES_MODEL_RESEARCH=
SALES_MODEL_PERSONALISE=

# Lead discovery. Phase 1 runs on CSV import alone; this is Phase 2.
GOOGLE_PLACES_API_KEY=

# Cold outbound email. NOT belline.ai — a separate, warmed sending domain, and
# a provider whose terms permit cold outreach. See docs/sales-engine/COMPLIANCE.md §4.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_SENDING_DOMAINS=
EMAIL_WEBHOOK_SECRET=
