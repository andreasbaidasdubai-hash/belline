# ---------------------------------------------------------------------------
# Belline — AI voice receptionist
#
# Copy to .env and fill in what you have. Every provider degrades to a mock
# implementation when its key is missing, so the app runs with an empty file.
# ---------------------------------------------------------------------------

# Brain. Without this the agent falls back to a scripted mock that still
# exercises the tool layer, so the dashboard and booking engine stay testable.
ANTHROPIC_API_KEY=

# Speech-to-text (streaming). Without it, browser voice mode records but
# transcribes nothing — use the text console instead.
DEEPGRAM_API_KEY=

# Text-to-speech (streaming). Without it, the agent replies in text only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# The voice a German venue still on the house voice speaks in. Add a native
# German voice to the ElevenLabs account first; unset keeps the house voice.
ELEVENLABS_VOICE_ID_DE=

# Answering customers in German (Germany, Austria, Switzerland). Off unless on.
# FLAG_LANGUAGE_DE=on

# Video receptionist (docs/video/README.md). Off unless on, and then only on
# the venues listed here or added in the sales console (/sales/video).
# FLAG_VIDEO_AVATAR=on
# tavus (default) or mock. The mock is refused in production and next to a
# real database; its panel says "MOCK — not a live avatar".
VIDEO_AVATAR_PROVIDER=
# From the Tavus PAL Maker → API Key. Server-side only, never in a browser.
TAVUS_API_KEY=
# The stock face, in Tavus's `face_id` (formerly replica_id). The prototype
# face is rf90eb925bd8.
TAVUS_FACE_ID=
# Optional: a template PAL (formerly persona) whose voice, hearing and
# turn-taking Belline's own PALs copy. Never used as-is.
TAVUS_PAL_ID=
# 40+ random characters. Signs the tokens that tie Tavus's model requests and
# callbacks to one conversation at one venue, and derives each venue PAL's key.
VIDEO_LLM_SECRET=
# shared (default: one PAL per venue and face, made by Belline and reused) or
# per_session (a short-lived PAL per call — slower start; the rollback).
VIDEO_TAVUS_PAL_MODE=
# Video small talk on this model first; any tool turn on the venue's model.
# Unset: claude-haiku-4-5. off: every turn on the venue's model.
VIDEO_FAST_MODEL=
# Option (b) of docs/video/voice.md: make the video face speak a public
# ElevenLabs or Cartesia voice (tts_engine elevenlabs|cartesia + its voice id).
VIDEO_TAVUS_TTS_ENGINE=
VIDEO_TAVUS_EXTERNAL_VOICE_ID=

# One voice everywhere (docs/video/voice.md): the phone and the website's voice
# button speak with the video receptionist's Cartesia voice on Belline's venue
# (and VOICE_UNIFY_VENUES). Off unless on, and inert without the key.
# FLAG_VOICE_UNIFY=on
CARTESIA_API_KEY=
VOICE_UNIFY_VOICE_ID=
VOICE_UNIFY_VENUES=
# Optional; default sonic-3.6.
CARTESIA_MODEL_ID=
# Where Tavus reaches this app. Defaults to PUBLIC_ORIGIN.
VIDEO_PUBLIC_ORIGIN=
# Comma-separated venue ids, e.g. loc_belline.
VIDEO_AVATAR_VENUES=
VIDEO_MAX_CALL_SECONDS=300
VIDEO_WARN_BEFORE_SECONDS=30
VIDEO_JOIN_TIMEOUT_SECONDS=60
VIDEO_MAX_SESSIONS_PER_DAY=20
VIDEO_MAX_CONCURRENT_PER_VENUE=2
# on: Tavus's speculative_inference (lower latency; a half-heard sentence may
# start a turn). Off by default.
VIDEO_TAVUS_SPECULATIVE=
# on: Tavus test_mode — free conversations that cannot be joined. For checking
# credentials only.
VIDEO_TAVUS_TEST_MODE=
# on: hard-delete each conversation at Tavus when it ends (Belline keeps its
# own transcript). See docs/video/privacy-review.md.
VIDEO_TAVUS_DELETE_AFTER_END=
# The greeting bubble's short muted clip and its poster: https URLs, or paths on
# this app (e.g. /video/greeting-rf90eb925bd8.mp4 in public/video). Make them
# once with: npm run video:clip -- --agent Belle --business Belline --yes --download public/video
# (spends Tavus credits; never run automatically). Unset: a lettered placeholder.
VIDEO_GREETING_CLIP_URL=
VIDEO_GREETING_POSTER_URL=

# Telephony (optional — only needed to answer real phone calls).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public wss:// origin Twilio should stream media to, e.g. wss://abc.ngrok.app
PUBLIC_WS_ORIGIN=
# An SMS-capable Twilio number. Set this and every booking gets a written
# confirmation, so nobody writes the reference down wrong.
TWILIO_SMS_FROM=

# Signs the short-lived token Twilio hands back when it opens a media stream.
# Set this to 40+ random characters in production; without it the stream
# endpoint falls back to the Twilio auth token, and then to a known default.
SESSION_SECRET=

# Where the book is written. Point this at a mounted volume in a container —
# the container's own filesystem is wiped on every deploy.
DATA_DIR=

PORT=3000

# ---------------------------------------------------------------------------
# Sales engine (docs/sales-engine/)
#
# All optional. Without DATABASE_URL the /sales dashboard reports "not
# configured" and the voice product behaves exactly as it does today.
# ---------------------------------------------------------------------------

# Postgres for the sales engine only. The voice product keeps its JSON store.
#   Railway: add a Postgres service, copy DATABASE_URL from its Variables tab.
#   Local:   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=belline postgres:16
DATABASE_URL=

# Background worker (npm run worker). Runs beside the voice server, not on Vercel.
SALES_WORKER_CONCURRENCY=4

# Models. Every sales task defaults to claude-opus-5; set one to trade cost for
# quality on that task alone. See docs/sales-engine/INTEGRATIONS.md §7.
SALES_DEFAULT_MODEL=
SALES_MODEL_RESEARCH=
SALES_MODEL_PERSONALISE=

# Where the app is reachable. Demo links and unsubscribe links in outreach are
# built from this — get it wrong and every link in every email 404s, because
# belline.ai is the static marketing site and has no /demo route.
PUBLIC_ORIGIN=https://app.belline.ai

# Required in the footer of cold outreach.
SENDER_POSTAL_ADDRESS=

# Lead discovery. Phase 1 runs on CSV import alone; this is Phase 2.
GOOGLE_PLACES_API_KEY=
# Planning figures only, for cost-per-lead reporting — the real charge comes
# from the provider. Places bills per request (up to 20 results), not per result.
GOOGLE_PLACES_COST_PER_REQUEST=0.035
ELEVENLABS_COST_PER_1K_CHARS=0.18

# Cold outbound email. NOT belline.ai — a separate, warmed sending domain, and
# a provider whose terms permit cold outreach. See docs/sales-engine/COMPLIANCE.md §4.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_SENDING_DOMAINS=
EMAIL_WEBHOOK_SECRET=

# Google Calendar. Optional: without these the integration is simply not
# offered. Create an OAuth client at console.cloud.google.com with the
# redirect URI https://app.belline.ai/api/integrations/google and the single
# scope calendar.events — Belline has no business reading anything else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=