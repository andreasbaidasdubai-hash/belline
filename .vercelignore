# What `vercel` must never upload for the static site. Vercel runs
# `npm run site` itself, so scripts/, public/, src/ and package.json stay.
.claude
.env
.env.*
data
.next
node_modules
audit
test-results
playwright-report
voice-samples
# Built output and local-only files: Vercel builds site/ itself, and uploading
# a second copy (plus docs and build caches) kept making uploads abort.
site
docs
*.tsbuildinfo
